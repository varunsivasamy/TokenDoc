# Application Configuration
APP_NAME=ClinicQ
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=clinicq_user
POSTGRES_PASSWORD=clinicq_password
POSTGRES_DB=clinicq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clinicq_user:clinicq_password@localhost:5432/clinicq_db

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
